{
  "expo": {
    "name": "CandleAlerts",
    "slug": "CandleAlerts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_1024.png",
    "scheme": "candlealerts",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.guytito.CandleAlerts"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.guytito.CandleAlerts"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon_192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10151D",
          "image": "./assets/splash_1080x1920.png",
          "imageWidth": 360
        }
      ],
      "./src/lib/withCandleAlertsNative.ts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
